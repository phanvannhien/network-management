# Network Topology Builder — cấu hình deploy (copy thành deploy/.env khi cần đổi giá trị mặc định)

# Cổng host truy cập web app
WEB_PORT=8068

# PostgreSQL (giá trị dưới là mặc định dev — ĐỔI mật khẩu khi chạy thật).
# Mật khẩu nằm trong URL kết nối: tránh ký tự @ : / ? # hoặc phải percent-encode.
POSTGRES_USER=ntb
# Change it for any real deployment (required).
POSTGRES_PASSWORD=ntb_dev_password
POSTGRES_DB=ntb
# Cổng host của Postgres cho dev (make dev-api, make test); chỉ bind 127.0.0.1
DB_PORT=5468

# Master key mã hóa bí mật (TOTP secret, kho mật khẩu) — 32 byte base64.
# Tạo: openssl rand -base64 32
# GIỮ RIÊNG, không nằm trong backup DB; mất key = mất toàn bộ bí mật đã mã hóa.
NTB_MASTER_KEY=
# Version of the master key (each `ntb rotate-master-key` bumps it). Rotation: stop the API, run
#   NTB_NEW_MASTER_KEY=<new key> ntb rotate-master-key
# then set NTB_MASTER_KEY=<new key> and NTB_MASTER_KEY_VERSION=<printed version> and start the API again.
NTB_MASTER_KEY_VERSION=1

# Sao lưu (P2-13, docs/OPERATIONS.md). Bật khi có mật khẩu sao lưu ≥ 16 ký tự — KHÁC master key, cất riêng
# (trình quản lý mật khẩu + bản in). Mất mật khẩu này = không đọc được các bản sao lưu.
# Tạo: openssl rand -base64 24
NTB_BACKUP_PASSPHRASE=
# Giờ sao lưu hằng ngày theo NTB_TIMEZONE (HH:MM, hoặc off). Máy tắt đúng giờ thì chạy bù khi bật lại.
NTB_BACKUP_TIME=02:00
# Giữ bao nhiêu bản: ngày,tuần,tháng (bản thủ công / trước nâng cấp: 5 bản mới nhất).
NTB_BACKUP_KEEP=7,4,12
# Thư mục trên máy chủ chứa file sao lưu (vd ổ NAS đã mount). Trống = volume Docker ntb_backups.
# Thư mục phải cho user uid 10001 ghi được: sudo chown 10001 /mnt/nas/ntb-backups
# NTB_BACKUP_HOST_DIR=/mnt/nas/ntb-backups

# Phiên bản hiển thị ở /api/healthz
NTB_VERSION=dev
# Deployment name shown as a badge in the UI unless "production" (e.g. staging, development).
NTB_ENV=production

# Calendar of the installation: expiry dates and the 07:00 alert e-mail (P2-05). IANA name.
NTB_TIMEZONE=Asia/Ho_Chi_Minh

# A TLS reverse proxy in front of the web container? Add its exact address so the real client IP is seen
# (rate limits, audit). Keep the nginx container address. Never a whole private range.
# NTB_TRUSTED_PROXIES=172.30.68.10/32,10.0.0.5/32
# Users reach the app over HTTPS only? Then always mark the session cookie Secure.
# NTB_COOKIE_SECURE=true
